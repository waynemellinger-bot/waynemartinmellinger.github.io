---
layout: base.njk
pagination:
  data: archive.topicPages
  size: 1
  alias: topic
permalink: "{{ topic.path }}"
eleventyComputed:
  title: "{{ topic.name }}"
  description: "Writing by Wayne Martin Mellinger, Ph.D., on {{ topic.name | lower }}: {{ topic.works.length }} works across all collections."
  breadcrumbs:
    - { label: "Topics", url: "/topics/" }
---
<header class="page-head">
  <p class="eyebrow">Topic</p>
  <h1>{{ topic.name }}</h1>
  <p class="lede">{{ topic.works.length }} work{{ '' if topic.works.length == 1 else 's' }} across all collections, newest first.</p>
  {%- if site.pilot %}<p class="pilot-note">During the pilot only Noozhawk columns are listed, and topic labels are a draft.</p>{% endif %}
</header>
{%- set list = topic.works %}{% set showVenue = true %}
{% include "works-by-year.njk" %}
