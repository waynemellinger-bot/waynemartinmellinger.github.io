---
layout: base.njk
pagination:
  data: archive.programPages
  size: 1
  alias: prog
permalink: "{{ prog.path }}"
eleventyComputed:
  title: "{{ prog.name }}"
  description: "Works by Wayne Martin Mellinger, Ph.D., in {{ prog.name }}, across all collections."
---
<header class="page-head">
  <p class="eyebrow">Body of work</p>
  <h1>{{ prog.name }}</h1>
  <p class="lede">{{ prog.works.length }} work{{ '' if prog.works.length == 1 else 's' }}, newest first.</p>
  {%- if site.pilot %}<p class="pilot-note">During the pilot this lists Noozhawk columns only; the scholarship, essays and books join as each collection moves.</p>{% endif %}
</header>
{%- set list = prog.works %}{% set showVenue = true %}
{% include "works-by-year.njk" %}
