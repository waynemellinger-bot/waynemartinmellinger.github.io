{#- Everything in <head> that describes the page: title, description, canonical address,
    sharing tags, and the structured data that identifies Wayne and the site. -#}
{%- set pageTitle = (title + ' — ' + site.name) if title and page.url != '/' else site.name -%}
{%- set pageDescription = description or site.description -%}
{%- set canonical = (canonicalUrl or page.url) | absolute(site.url) -%}
{%- set shareImage = (ogImage or site.share_image) | absolute(site.url) -%}
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<meta name="author" content="Wayne Martin Mellinger">
<link rel="canonical" href="{{ canonical }}">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:locale" content="{{ site.locale }}">
<meta property="og:image" content="{{ shareImage }}">
<meta property="og:image:alt" content="{{ images.portrait.alt }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title or site.name }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ shareImage }}">
<link rel="icon" href="/assets/favicon.svg" type="image/svg+xml">
{%- set sameAs = [] %}{% for e in site.elsewhere %}{% if e.sameAs %}{% set sameAs = (sameAs.push(e.url), sameAs) %}{% endif %}{% endfor %}
{%- set graph = [
  {
    "@type": "Person",
    "@id": site.url + "/#person",
    "name": "Wayne Martin Mellinger",
    "honorificSuffix": "Ph.D.",
    "url": site.url + "/",
    "image": (site.share_image | absolute(site.url)),
    "jobTitle": "Sociologist",
    "description": "Independent sociologist, writer, street outreach worker, and public intellectual based in Santa Barbara, California.",
    "address": { "@type": "PostalAddress", "addressLocality": "Santa Barbara", "addressRegion": "CA", "addressCountry": "US" },
    "alumniOf": [{ "@type": "CollegeOrUniversity", "name": "University of California, Santa Barbara" }, { "@type": "CollegeOrUniversity", "name": "University of Massachusetts Amherst" }],
    "sameAs": sameAs
  },
  {
    "@type": "WebSite",
    "@id": site.url + "/#website",
    "name": site.name,
    "url": site.url + "/",
    "inLanguage": "en",
    "author": { "@id": site.url + "/#person" },
    "publisher": { "@id": site.url + "/#person" },
    "potentialAction": { "@type": "SearchAction", "target": site.url + "/search/?q={search_term_string}", "query-input": "required name=search_term_string" }
  }
] %}
{%- if breadcrumbs or page.url != '/' %}
{%- set crumbs = [{ "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" }] %}
{%- for b in breadcrumbs %}{% set crumbs = (crumbs.push({ "@type": "ListItem", "position": loop.index + 1, "name": b.label, "item": b.url | absolute(site.url) }), crumbs) %}{% endfor %}
{%- set crumbs = (crumbs.push({ "@type": "ListItem", "position": crumbs.length + 1, "name": crumbTitle or title, "item": canonical }), crumbs) %}
{%- set graph = (graph.push({ "@type": "BreadcrumbList", "itemListElement": crumbs }), graph) %}
{%- endif %}
<script type="application/ld+json">{{ { "@context": "https://schema.org", "@graph": graph } | json | safe }}</script>
