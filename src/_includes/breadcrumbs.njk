<nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore="all">
  <ol>
    <li><a href="/">Home</a></li>
    {%- for b in breadcrumbs %}
    <li><a href="{{ b.url }}">{{ b.label }}</a></li>
    {%- endfor %}
    <li><span aria-current="page">{{ crumbTitle or title }}</span></li>
  </ol>
</nav>
