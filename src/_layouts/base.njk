<!DOCTYPE html>
<html lang="en">
<head>
{% include "meta.njk" %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400&family=IBM+Plex+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/assets/css/site.css">
{% block head %}{% endblock %}
<script>document.documentElement.classList.add('js');</script>
</head>
<body class="{{ bodyClass }}">
<a class="skip-link" href="#main">Skip to content</a>
{%- if site.pilot %}
<div class="pilot-bar" data-pagefind-ignore="all">Preview. This site has not been published yet.</div>
{%- endif %}
<header class="site-header" data-pagefind-ignore="all">
  <div class="wrap wide header-inner">
    <a class="brand" href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>{{ site.name }}</a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {#- Mark the current page (aria-current="page") or, failing that, the one menu entry
            whose area contains it: the longest menu url that the page url, or its breadcrumb
            trail, starts with. Home is only ever marked on the home page itself. -#}
        {%- set trail = [page.url] %}{% for b in (breadcrumbs or []) %}{% set trail = (trail.push(b.url), trail) %}{% endfor %}
        {%- set best = '' %}
        {%- for item in site.nav %}{% if item.url != '/' %}{% for t in trail %}
          {%- if t.startsWith(item.url) and item.url.length > best.length %}{% set best = item.url %}{% endif %}
        {%- endfor %}{% endif %}{% endfor %}
        {%- for item in site.nav %}
        {%- set exact = page.url == item.url %}
        <li><a href="{{ item.url }}"{% if item.title %} title="{{ item.title }}"{% endif %}{% if exact %} aria-current="page"{% elif item.url == best %} aria-current="true"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>

<main id="main" tabindex="-1"{% if not noindex %} data-pagefind-body{% endif %}>
  <div class="wrap{% if wide %} wide{% endif %}">
    {% if breadcrumbs %}{% include "breadcrumbs.njk" %}{% endif %}
    {{ content | safe }}
  </div>
</main>

<footer class="site-footer" data-pagefind-ignore="all">
  <div class="wrap wide footer-inner">
    <div>
      <p class="footer-name">{{ site.name }}</p>
      <p class="footer-place">Santa Barbara, California</p>
      <p class="footer-mail"><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>
    <nav aria-label="Site">
      <h2 class="label">This site</h2>
      <ul class="footer-links">
        <li><a href="/writing/">All writing</a></li>
        <li><a href="/topics/">Topics</a></li>
        <li><a href="/research/">Research</a></li>
        <li><a href="/community/">Community work</a></li>
        <li><a href="/creative-work/">Poetry &amp; creative work</a></li>
        <li><a href="/cv/">CV</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a href="/legacy/">The previous site, preserved</a></li>
      </ul>
    </nav>
    <nav aria-label="Elsewhere">
      <h2 class="label">Elsewhere</h2>
      <ul class="footer-links">
        {%- for e in site.elsewhere %}
        <li><a href="{{ e.url }}"{% if e.sameAs %} rel="me"{% endif %}>{{ e.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</footer>
<script src="/assets/js/menu.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
