<!DOCTYPE html>
<html lang="en">
<head>
{% include "meta.njk" %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400&family=IBM+Plex+Mono:wght@400;500&display=swap">
<link rel="stylesheet" href="/assets/css/site.css">
{% block head %}{% endblock %}
<script>document.documentElement.classList.add('js');</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
{% if site.pilot %}
<div class="pilot-bar" data-pagefind-ignore="all">Preview: Noozhawk pilot. Other sections have not moved to the new site yet.</div>
{% endif %}
<header class="site-header" data-pagefind-ignore="all">
  <div class="wrap header-inner">
    <a class="brand" href="/">{{ site.name }}</a>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {%- for item in site.nav %}
        {%- set current = page.url == item.url or (page.url.startsWith(item.url) and item.url != '/') %}
        <li><a href="{{ item.url }}"{% if current %} aria-current="{{ 'page' if page.url == item.url else 'true' }}"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
  </div>
</header>

<main id="main" tabindex="-1"{% if not placeholder %} data-pagefind-body{% endif %}>
  <div class="wrap">
    {% if breadcrumbs %}{% include "breadcrumbs.njk" %}{% endif %}
    {{ content | safe }}
  </div>
</main>

<footer class="site-footer" data-pagefind-ignore="all">
  <div class="wrap footer-inner">
    <p class="footer-name">{{ site.name }}<br><span>Santa Barbara, California</span></p>
    <ul class="footer-links" aria-label="Elsewhere">
      {%- for e in site.elsewhere %}
      <li><a href="{{ e.url }}">{{ e.label }}</a></li>
      {%- endfor %}
      <li><a href="/legacy/#contact">Contact</a></li>
    </ul>
  </div>
</footer>
<script src="/assets/js/menu.js" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>
